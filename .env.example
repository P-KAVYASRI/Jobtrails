# Copy this file to .env and fill in your values (never commit .env)

# ---------- REQUIRED ----------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jobtrail?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000

# ---------- OPTIONAL: AI assistant (cover letters, interview questions) ----------
# Get a key at console.anthropic.com  (needs API credits)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- OPTIONAL: daily email reminders ----------
# Gmail: turn on 2-step verification, then create an "App password" and paste it as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Any random string. Vercel sends it automatically to protect the cron endpoint
CRON_SECRET=
